+static int av1_mpegts_reformat(AVFormatContext *s, const uint8_t *src,
+                               int src_size, uint8_t **dst, int *dst_size)
+{
+    const uint8_t *p = src, *end = src + src_size;
+    uint8_t *out, *q;
+    size_t total = 0;
+
+    while (p < end) {
+        int64_t obu_size;
+        int start_pos, type, temporal_id, spatial_id;
+        int len = parse_obu_header(p, end - p, &obu_size, &start_pos,
+                                   &type, &temporal_id, &spatial_id);
+
+        if (len < 0)
+            return len;
+        if (type == AV1_OBU_TILE_LIST) {
+            av_log(s, AV_LOG_ERROR,
+                   "Tile List OBUs are forbidden in AV1 MPEG-TS\n");
+            return AVERROR_INVALIDDATA;
+        }
+        if (total > INT_MAX - 3 ||
+            av1_escape_obu(NULL, p, len) > INT_MAX - total - 3)
+            return AVERROR(ERANGE);
+        total += 3 + av1_escape_obu(NULL, p, len);
+        p += len;
+    }
+
+    out = av_malloc(total + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!out)
+        return AVERROR(ENOMEM);
+
+    p = src;
+    q = out;
+    while (p < end) {
+        int64_t obu_size;
+        int start_pos, type, temporal_id, spatial_id;
+        int len = parse_obu_header(p, end - p, &obu_size, &start_pos,
+                                   &type, &temporal_id, &spatial_id);
+
+        av_assert1(len > 0);
+        *q++ = 0;
+        *q++ = 0;
+        *q++ = 1;
+        q += av1_escape_obu(q, p, len);
+        p += len;
+    }
+    memset(q, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+
+    *dst = out;
+    *dst_size = total;
+    return 0;
+}
