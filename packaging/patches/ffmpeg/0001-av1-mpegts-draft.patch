+static int put_av1_video_descriptor(AVFormatContext *s, uint8_t **q_ptr,
+                                    const AVCodecParameters *par)
+{
+    AV1SequenceParameters seq;
+    uint8_t *q = *q_ptr;
+    int hdr, wcg, hdr_wcg_idc;
+    int ret = ff_av1_parse_seq_header(&seq, par->extradata,
+                                      par->extradata_size);
+
+    if (ret < 0) {
+        av_log(s, AV_LOG_ERROR,
+               "AV1 MPEG-TS requires sequence-header extradata\n");
+        return ret;
+    }
+
+    hdr = seq.transfer_characteristics == AVCOL_TRC_SMPTE2084 ||
+          seq.transfer_characteristics == AVCOL_TRC_ARIB_STD_B67;
+    wcg = seq.color_primaries == AVCOL_PRI_BT2020;
+    if (seq.transfer_characteristics == AVCOL_TRC_UNSPECIFIED ||
+        seq.color_primaries == AVCOL_PRI_UNSPECIFIED || (hdr && !wcg))
+        hdr_wcg_idc = 3;
+    else if (hdr)
+        hdr_wcg_idc = 2;
+    else if (wcg)
+        hdr_wcg_idc = 1;
+    else
+        hdr_wcg_idc = 0;
+
+    *q++ = AV1_VIDEO_DESCRIPTOR;
+    *q++ = 4;
+    *q++ = 0x80 | 1; /* marker, descriptor version 1 */
+    *q++ = seq.profile << 5 | seq.level;
+    *q++ = seq.tier << 7 | (seq.bitdepth > 8) << 6 |
+           (seq.bitdepth == 12) << 5 | seq.monochrome << 4 |
+           seq.chroma_subsampling_x << 3 |
+           seq.chroma_subsampling_y << 2 | seq.chroma_sample_position;
+    *q++ = hdr_wcg_idc << 6; /* no initial presentation delay */
+    *q_ptr = q;
+
+    return 0;
+}
