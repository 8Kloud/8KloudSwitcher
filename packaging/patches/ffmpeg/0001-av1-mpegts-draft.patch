+static size_t av1_escape_obu(uint8_t *dst, const uint8_t *src, size_t size)
+{
+    size_t out = 0;
+    int zero_count = 0;
+
+    for (size_t i = 0; i < size; i++) {
+        if (zero_count >= 2 && src[i] <= 3) {
+            if (dst)
+                dst[out] = 3;
+            out++;
+            zero_count = 0;
+        }
+        if (dst)
+            dst[out] = src[i];
+        out++;
+        zero_count = src[i] == 0 ? zero_count + 1 : 0;
+    }
+
+    return out;
+}
