+static int av1_mpegts_unescape(uint8_t *data, int size)
+{
+    int src = 0, dst = 0, obu_count = 0;
+
+    while (src < size) {
+        int zero_count = 0;
+
+        if (src + 3 > size || data[src] || data[src + 1] || data[src + 2] != 1)
+            return AVERROR_INVALIDDATA;
+        src += 3;
+        obu_count++;
+
+        while (src < size &&
+               !(src + 3 <= size && !data[src] && !data[src + 1] &&
+                 data[src + 2] == 1)) {
+            uint8_t value = data[src++];
+
+            if (zero_count >= 2 && value == 3) {
+                if (src >= size || data[src] > 3)
+                    return AVERROR_INVALIDDATA;
+                zero_count = 0;
+                continue;
+            }
+            data[dst++] = value;
+            zero_count = value == 0 ? zero_count + 1 : 0;
+        }
+    }
+
+    return obu_count ? dst : AVERROR_INVALIDDATA;
+}
